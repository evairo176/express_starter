PORT=3000

# Mandatory: For encrypting your jwt token
JWT_SECRET=2323244242

DATABASE_URL=dawdawdawdawd

# Mailer (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAILER_SENDER=onboarding@example.com
# Recipient for contact form owner notifications.
# Falls back to MAILER_SENDER when unset.
CONTACT_OWNER_EMAIL=owner@example.com

# Optional: max TTL (ms) for cached public GET responses (default 60000)
CACHE_MAX_TTL_MS=60000

# Blog comment moderation (optional, default enabled).
# When enabled, newly created comments start unapproved and are hidden from
# public comment responses until an admin approves them. Set to "false" to
# auto-approve comments on submission.
COMMENT_MODERATION=true

# Rate limiting (optional, sensible defaults applied if unset)
# Auth endpoints (/auth/*): default 15 min window, 10 requests
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Public write endpoints (contact, newsletter, comments, reactions): default 15 min window, 30 requests
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=30

# CORS allowlist (optional): comma-separated list of allowed origins for
# cross-origin requests. When unset, a development default is applied
# (http://localhost:3000, http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database backup -> Telegram (scheduled cron, default 00:00 daily).
# The job only runs when BOTH the bot token and chat id below are set.
BACKUP_ENABLED=true
# Cron expression (default: every day at midnight).
BACKUP_CRON=0 0 * * *
# IANA timezone used to interpret the schedule.
BACKUP_TIMEZONE=Asia/Jakarta
# Telegram Bot API credentials (fill these in yourself).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
