generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TYPE_USER {
  TENANT
  REGISTER
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  // Tambahkan sesuai kebutuhanmu
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // relations
  userPreferences   UserPreferences?
  sessions          Session[]
  verificationCodes VerificationCode[]
}

model UserPreferences {
  id                String  @id @default(uuid()) @db.Uuid
  enable2FA         Boolean @default(false)
  emailNotification Boolean @default(true)
  twoFactorSecret   String?

  // relation
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.Uuid
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userAgent String?
  isRevoke  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiredAt DateTime
}

model VerificationCode {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  code      String           @unique
  type      VerificationType
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@map("verification_codes") // agar sesuai dengan collection/tabel lama jika perlu
}

// =====================
// CATEGORY
// =====================
model PortfolioCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios Portfolio[]
}

// =====================
// TAG
// =====================
model PortfolioTag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  portfolios PortfolioTagOnPortfolio[]
}

// pivot table many-to-many
model PortfolioTagOnPortfolio {
  portfolioId String
  tagId       String

  portfolio Portfolio    @relation(fields: [portfolioId], references: [id])
  tag       PortfolioTag @relation(fields: [tagId], references: [id])

  @@id([portfolioId, tagId])
}

// =====================
// TECH STACK
// =====================
model TechStack {
  id   String  @id @default(uuid())
  name String  @unique
  icon String? // optional URL atau icon name

  portfolios TechStackOnPortfolio[]
}

// pivot table many-to-many
model TechStackOnPortfolio {
  portfolioId String
  techId      String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  tech      TechStack @relation(fields: [techId], references: [id])

  @@id([portfolioId, techId])
}

// =====================
// IMAGE
// =====================
model PortfolioImage {
  id          String  @id @default(uuid())
  portfolioId String
  url         String
  alt         String?
  position    Int     @default(0) // untuk ordering (hero image, gallery)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
}

// =====================
// PORTFOLIO (MAIN)
// =====================
model Portfolio {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  shortDesc   String? // untuk card list
  categoryId  String?
  isPublished Boolean @default(true)

  liveUrl  String?
  repoUrl  String?
  featured Boolean @default(false)

  // case study
  problem  String? @db.Text
  solution String? @db.Text
  results  String? @db.Text

  // SEO
  metaTitle String?
  metaDesc  String?
  metaImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  category   PortfolioCategory?        @relation(fields: [categoryId], references: [id])
  images     PortfolioImage[]
  tags       PortfolioTagOnPortfolio[]
  techStacks TechStackOnPortfolio[]
  views      PortfolioView[]
}

model Image {
  id               String    @id @default(uuid())
  publicId         String    @unique
  url              String
  secureUrl        String?
  folder           String?
  name             String? // <= TAMBAHKAN FIELD INI
  originalFilename String?
  format           String?
  width            Int?
  height           Int?
  bytes            Int?
  resourceType     String?
  uploadedAt       DateTime?
  provider         String    @default("cloudinary")
  tags             String[]  @default([])
  createdAt        DateTime  @default(now())
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  excerpt     String?
  content     String?  @db.Text
  coverImage  String?
  isPublished Boolean  @default(false)
  totalViews  Int      @default(0)
  totalLikes  Int      @default(0)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  category  BlogCategory?       @relation(fields: [categoryId], references: [id])
  tags      BlogTagOnBlogPost[]
  comments  BlogComment[]
  reactions BlogReaction[]
  views     BlogPostView[]
}

// =====================
// BLOG CATEGORY & TAGS
// =====================
model BlogCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

model BlogTag {
  id    String              @id @default(uuid())
  name  String
  slug  String              @unique
  posts BlogTagOnBlogPost[]
}

model BlogTagOnBlogPost {
  blogPostId String   @db.Uuid
  tagId      String
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
}

// =====================
// BLOG COMMENTS, REACTIONS, VIEWS
// =====================
model BlogComment {
  id         String   @id @default(uuid())
  blogPostId String   @db.Uuid
  name       String
  email      String
  body       String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId, isApproved, createdAt])
}

model BlogReaction {
  id         String   @id @default(uuid())
  blogPostId String   @db.Uuid
  type       String   @default("like")
  createdAt  DateTime @default(now())
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
}

model BlogPostView {
  id         String   @id @default(uuid())
  blogPostId String   @db.Uuid
  sessionId  String
  createdAt  DateTime @default(now())
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, sessionId])
  @@index([blogPostId, createdAt])
}

// =====================
// CONTACT, NEWSLETTER, TESTIMONIAL
// =====================
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscription {
  id               String   @id @default(uuid())
  email            String   @unique
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String
  authorRole  String
  quote       String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// =====================
// ACHIEVEMENT (awards / certifications / milestones)
// =====================
model Achievement {
  id          String   @id @default(uuid())
  title       String
  issuer      String?
  description String?  @db.Text
  date        DateTime
  url         String?
  icon        String?
  category    String?
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, position])
}

// =====================
// ANALYTICS
// =====================
model VisitEvent {
  id        String   @id @default(uuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model PortfolioView {
  id          String    @id @default(uuid())
  portfolioId String
  sessionId   String
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, sessionId])
}
